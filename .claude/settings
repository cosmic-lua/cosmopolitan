{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && bin/cosmic --version >/dev/null 2>&1 && test -e bin/lua || ln -sf cosmic-lua bin/lua && echo \"export PATH=\\\"$CLAUDE_PROJECT_DIR/bin:\\$PATH\\\"\" >> \"$CLAUDE_ENV_FILE\""
          }
        ]
      }
    ]
  }
}
