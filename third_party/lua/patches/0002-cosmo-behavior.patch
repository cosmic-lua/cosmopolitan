# cosmo behavior and portability: the semantic differences that make Lua
# work as cosmopolitan's embedded runtime rather than a standalone system
# install.
#   lua.h / luaconf.h  - COSMOPOLITAN_C_START_/END_ header guard, LUA_ROOT
#                         under the zip payload (/zip/.lua/), LUA_USE_LINENOISE
#                         and LUA_USE_POSIX, api-check gated on IsModeDbg(),
#                         a MODE_DBG hook that pulls in ltests.h without the
#                         unsafe LUA_USER_H kludge, and g_lua_path_default as
#                         a mutable global (see loadlib.c) so a hosted script
#                         can override the module search path
#   loadlib.c          - routes LUA_PATH_DEFAULT through g_lua_path_default
#   ltm.h              - TMS enum moved to (non-stock) tms.h so both ltm.c and
#                         the C API binding layer can share it without a
#                         circular include
#   lctype.h           - lctype.c is not vendored (see update.sh); reimplements
#                         its table-driven ctype tests as branchless GCC
#                         statement-expression macros, and adds lisbdigit for
#                         binary-literal support
#   lobject.c/.h       - luaO_ceillog2 becomes a static inline using the bsr
#                         intrinsic instead of a lookup table; luaO_str2int
#                         gains 0b binary-literal parsing and treats a leading
#                         0 as octal rather than decimal
#   lstrlib.c          - string.__mul and string.__mod grow python-style
#                         operators: str * n repeats (aliases string.rep),
#                         str % {...} formats (aliases string.format)
#   ldo.c              - LUAI_THROW uses plain longjmp (cosmopolitan's setjmp
#                         is already the non-restoring variant); a stack
#                         overflow that has no error handler installed calls
#                         the weakly-linked __die() instead of abort() and
#                         falls back to _Exit() when it's not linked in
#   ltests.c           - same __die() swap for its internal consistency checks
#   loslib.c           - os.tmpname() builds its template from __get_tmpdir()
#                         with strlcpy/strlcat instead of a hardcoded
#                         "/tmp/lua_XXXXXX", since /tmp is not universal
#                         across cosmopolitan's supported platforms
#   llex.c             - '\e' is accepted as an ESC (0x1b) escape in string
#                         literals, matching GCC's C extension
#   lmem.c             - warns via WARNF before retrying a failed malloc()
#                         through the garbage collector, for --strace visibility
# regenerate by diffing against the pristine mechanically-rewritten sources
# (run update.sh with patches/ moved aside).
